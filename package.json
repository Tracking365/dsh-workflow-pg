{
  "name": "dsh-devkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "native/index.mjs",
  "exports": {
    ".": "./native/index.mjs",
    "./core": "./dist/src/index.js"
  },
  "files": [
    "dist/src",
    "native",
    "cordis.patch.yml",
    "skills",
    "docs",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js tests/native/*.test.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "demo": "npm run build && node scripts/demo.mjs",
    "prepack": "npm run build",
    "test:pack": "node scripts/check-pack.mjs",
    "test:launcher": "npm run build && node scripts/test-dsh-launcher.mjs",
    "test:codex-provider-profile": "node scripts/test-codex-provider-profile.mjs",
    "test:seatbelt-host": "npm run build && DSH_DEVKIT_REQUIRE_SEATBELT=1 node --test tests/native/seatbelt-host.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.3",
    "@deepseek-ai/dsh-subagent": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-subagent-codex": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-subagent": {
      "optional": true
    },
    "@deepseek-ai/dsh-subagent-codex": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.3",
    "@deepseek-ai/dsh": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-agent": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-agent-loop": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-subagent": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-subagent-codex": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.2",
    "@types/node": "22.10.2",
    "typescript": "5.7.2"
  }
}
